# ==============================================================================
# Meet Duo - Environment Configuration Example
# Copy this file to .env.local for local development
# ==============================================================================

# Application URL (used for sharing invite links / absolute URLs)
# Optional: Defaults to window.location.origin on client
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WebRTC & STUN / TURN Configuration (Optional)
# PeerJS uses public Google & Twilio STUN servers by default.
# If you run a custom PeerServer or TURN server behind strict NAT/Firewalls:
# NEXT_PUBLIC_PEER_HOST=
# NEXT_PUBLIC_PEER_PORT=
# NEXT_PUBLIC_PEER_PATH=/peerjs
# NEXT_PUBLIC_PEER_SECURE=true
